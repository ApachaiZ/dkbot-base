# ── Modèle de configuration ─────────────────────────────────────────────────
# Copier ce fichier dans le dossier de données du bot :
#   cp .config.d/.env.example ~/.config/dakkabot/.config.d/.env
# (ou <dossier --root>/.config.d/.env pour un déploiement système).
# Le bot lit `.config.d/.env` au démarrage, RELATIF à son dossier de
# données. Si le fichier existe, ses valeurs sont utilisées telles quelles
# et seules les valeurs requises manquantes sont redemandées en mode
# interactif. Les valeurs factices (YOUR_…) bloquent le démarrage (exit 78).

# ── Discord (obligatoire) ───────────────────────────────────────────────────
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
DISCORD_CLIENT_ID=YOUR_APPLICATION_ID
DISCORD_OWNER_ID=YOUR_DISCORD_USER_ID
# Guildes autorisées (multi-guilde) : liste d'IDs séparés par des virgules.
# Repli : DISCORD_GUILD_ID (une seule guilde).
DISCORD_GUILD_IDS=
DISCORD_GUILD_ID=YOUR_GUILD_ID

# ── Langue (en | fr) ────────────────────────────────────────────────────────
BOT_LANGUAGE=fr

# ── Machines cibles ─────────────────────────────────────────────────────────
# alias=spec, séparées par des virgules. Spec :
#   local                  → la machine où tourne le bot (défaut si absent)
#   [user@]hôte[:port]     → machine distante en SSH
# La première cible est la cible par défaut ; « local » est un alias réservé.
TARGETS=local,prod=root@vps.example.com

# ── SSH (pour les cibles distantes) ─────────────────────────────────────────
# Utilisateur par défaut des cibles sans « user@ » (défaut : utilisateur
# système du bot).
SSH_USER=root
# Authentification : clé privée OU mot de passe (la clé est essayée
# d'abord). Clé par défaut : ~/.ssh/id_ed25519 sinon ~/.ssh/id_rsa.
SSH_KEY_PATH=/home/USER/.ssh/id_ed25519
#SSH_PASSWORD=mon_mot_de_passe
# Fichier de clés d'hôte connues (TOFU FAIL-CLOSED : la première clé vue
# est enregistrée et RELUE pour vérification ; toute clé différente ensuite
# refuse la connexion ; un fichier illisible ou non inscriptible refuse
# aussi la connexion). Sous une unité systemd durcie (ProtectHome=true),
# pointez un chemin INSCRIPTIBLE, ex. /opt/dakkabot/.config.d/known_hosts.
SSH_KNOWN_HOSTS_FILE=.config.d/known_hosts
# (en mode portable, ~/.ssh/known_hosts convient)
SSH_TIMEOUT_SECS=20

# ── Services applicatifs (unités systemd) ───────────────────────────────────
# alias=unité, séparées par des virgules — le premier est le défaut.
# N'importe quelle unité systemd valide peut être contrôlée depuis le bot.
# Forme mono-service : SERVICE=myservice (alias « default »).
SERVICES=web=nginx,game=myserver

# Préfixe de systemctl si root est requis (appliqué localement ET à
# distance). Exemples : « sudo », « sudo -n ». Vide = pas de préfixe.
# Avec sudo, configurez NOPASSWD pour la commande systemctl.
SYSTEMCTL_PREFIX=

# ── Watchdog (optionnel — désactivé sans DISCORD_ALERT_CHANNEL_ID) ──────────
# Salon Discord où partent les alertes (crash du service, CPU/RAM/disque).
DISCORD_ALERT_CHANNEL_ID=
# Canal d'AUDIT (actions confirmées, planificateur, sauvegardes, reboot).
# Vide = repli sur DISCORD_ALERT_CHANNEL_ID.
DISCORD_AUDIT_CHANNEL_ID=
# Intervalle de scan en millisecondes (défaut : 60000).
ALERT_INTERVAL_MS=60000
# Seuils d'alerte en % (défauts : 90).
WATCHDOG_CPU_PCT=90
WATCHDOG_RAM_PCT=90
WATCHDOG_DISK_PCT=90


# ── Logs du service (/logs) ─────────────────────────────────────────────────
# Défaut : journald (`journalctl -u <unité>`). Pour lire un fichier :
#LOG_FILE=/opt/myservice/logs/server.log
# Nombre de lignes lues (défaut : 50).
LOG_LINES=50

# ── Sauvegardes du jeu (copie à chaque stop/start/restart) ──────────────────
# Chemin ABSOLU du dossier de sauvegardes du jeu sur la machine cible.
# Dès que l'arrêt du service est avéré, le dossier est archivé en .tar dans
# <SAVES_PATH>-backups/ — le nom de l'archive est l'horodatage UTC
# (<AAAAMMJJ-HHMMSS>.tar). Restauration : tar -xf <archive> dans le dossier parent.
# Politique : le script vérifie lui-même que l'unité est inactive (et supprime
# l'archive si le service redémarre pendant sa création) ; lock de sauvegarde
# (jamais deux copies simultanées) ; pas de recopie si une copie date de moins
# d'une heure ; les 20 plus récents seulement sont conservés.
# Vide = pas de copie : l'action power s'exécute quand même, la carte Discord
# et les logs le signalent.
#SAVES_PATH=/opt/game/saves
# Délai maximal d'une copie en secondes (défaut : 600).
SAVES_COPY_TIMEOUT_SECS=600
